   "source": [
    "def invertion_count(arr):\n",
    "    c=0\n",
    "    for i in range(len(arr)):\n",
    "        for j in range(i+1,len(arr)):\n",
    "            if(arr[i]>arr[j]):\n",
    "                c+=1\n",
    "    print(c)"
   ]
  },
