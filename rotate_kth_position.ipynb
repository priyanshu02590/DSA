   "outputs": [],
   "source": [
    "def rotate_kth_position(arr,k):\n",
    "    n=len(arr)\n",
    "    k=k%n\n",
    "    res=[0]*n\n",
    "    for i in range(n):\n",
    "        res[(i+k)%n]=arr[i]\n",
    "    return res"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "a3ebd7b3-ff68-484b-a8ab-d0a5956a1e2f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[np.int64(4), np.int64(5), np.int64(1), np.int64(2), np.int64(3)]\n"
     ]
    }
   ],
   "source": [
    "import numpy as np\n",
    "a=np.array([1,2,3,4,5])\n",
    "k=2\n",
    "p=rotate_kth_position(a,k)\n",
    "print(p)"
   ]
