   "source": [
    "import numpy as np\n",
    "arr=np.array([1,3,6,7,9,11,12])\n",
    "key=9"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "08b17d51-8792-4028-a50f-59ca342ded06",
   "metadata": {},
   "outputs": [],
   "source": [
    "def linear_search(arr,key):\n",
    "    n=len(arr)\n",
    "    for i in range(n):\n",
    "        if(arr[i]==key):\n",
    "            return i\n",
    "    return -1"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "8d3177db-9966-4703-ae07-b08a89ff6a60",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "4 9\n"
     ]
    }
   ],
   "source": [
    "a=linear_search(arr,key)\n",
    "print(a,arr[a])"
   ]
