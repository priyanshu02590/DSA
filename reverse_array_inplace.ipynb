   "outputs": [],
   "source": [
    "def rev(arr):\n",
    "    l=0\n",
    "    h=len(arr)-1\n",
    "    while(l<h):\n",
    "        arr[l],arr[h]=arr[h],arr[l]\n",
    "        l+=1\n",
    "        h-=1"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 28,
   "id": "9f810116-4d82-4543-b588-c691a50317f0",
